   "source": [
    "# --- Deep dive de JAN/2024 para o SKU 1813 com concentração por cliente (CLI_CPF) ---\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ===== 1) Carregar vendas =====\n",
    "vendas = pd.read_csv(r'C:\\Users\\felip\\OneDrive\\Documentos\\GitHub\\Grupo6-ProjetoFinal\\data\\raw\\vendas.csv', encoding='utf-8')  # ajuste encoding se necessário\n",
    "vendas['DATA_ATEND'] = pd.to_datetime(vendas['DATA_ATEND'])\n",
    "vendas['SKU'] = pd.to_numeric(vendas['SKU'], errors='coerce').astype('Int64')\n",
    "vendas['FATUR_VENDA'] = pd.to_numeric(vendas['FATUR_VENDA'], errors='coerce').fillna(0.0)\n",
    "\n",
    "# Normaliza identificador de cliente\n",
    "vendas['CLI_CPF'] = vendas['CLI_CPF'].astype(str).str.strip().replace({'': 'SEM_CPF', 'nan': 'SEM_CPF', 'None':'SEM_CPF'})\n",
    "\n",
    "# ===== 2) Foco: SKU 1813 em JAN/2024 =====\n",
    "sku_alvo = 1813\n",
    "mask_jan = (vendas['DATA_ATEND'].dt.year == 2024) & (vendas['DATA_ATEND'].dt.month == 1)\n",
    "df_jan = vendas.loc[mask_jan & (vendas['SKU'] == sku_alvo)].copy()\n",
    "\n",
    "if df_jan.empty:\n",
    "    raise ValueError(\"Sem dados do SKU 1813 em JAN/2024 no arquivo vendas.csv.\")\n",
    "\n",
    "# Série diária para contexto + dia de pico\n",
    "daily = (df_jan.groupby(df_jan['DATA_ATEND'].dt.date)['FATUR_VENDA']\n",
    "         .sum().rename('fatur').reset_index().rename(columns={'DATA_ATEND':'data'}))\n",
    "peak_idx = daily['fatur'].idxmax()\n",
    "peak_day = pd.to_datetime(daily.loc[peak_idx, 'data'])\n",
    "peak_val = float(daily.loc[peak_idx, 'fatur'])\n",
    "\n",
    "print(f\"[Contexto] JAN/2024 — dias com venda do SKU 1813: {len(daily)} | \"\n",
    "      f\"Dia de pico: {peak_day.date()} (R$ {peak_val:,.2f})\")\n",
    "\n",
    "# ===== 3) Concentração no dia de pico (por cliente) =====\n",
    "df_peak = df_jan.loc[df_jan['DATA_ATEND'].dt.date == peak_day.date()].copy()\n",
    "by_client = (df_peak.groupby('CLI_CPF')['FATUR_VENDA']\n",
    "             .sum().sort_values(ascending=False).rename('fatur_cli').reset_index())\n",
    "total_peak = by_client['fatur_cli'].sum()\n",
    "by_client['share'] = by_client['fatur_cli'] / total_peak\n",
    "\n",
    "# Métricas de concentração\n",
    "top1_share = by_client['share'].iloc[0] if not by_client.empty else 0.0\n",
    "top5_share = by_client['share'].head(5).sum()\n",
    "hhi = (by_client['share']**2).sum()                              # Herfindahl-Hirschman (0–1)\n",
    "gini = (2 * (np.arange(1, len(by_client)+1) * by_client['fatur_cli'].values).sum()\n",
    "        / (len(by_client) * by_client['fatur_cli'].sum()) - (len(by_client)+1)/len(by_client)) if len(by_client) > 0 else 0\n",
    "\n",
    "print(\"\\n[Concentração no dia de pico — por cliente (CLI_CPF)]\")\n",
    "print(f\"- Clientes distintos no dia: {by_client.shape[0]}\")\n",
    "print(f\"- Top-1 share: {top1_share*100:,.2f}%\")\n",
    "print(f\"- Top-5 share: {top5_share*100:,.2f}%\")\n",
    "print(f\"- HHI: {hhi:,.3f}  (≈0 competitivo, →1 concentrado)\")\n",
    "print(f\"- Gini: {gini:,.3f} (0 = uniforme, 1 = concentrado)\")\n",
    "\n",
    "# (Opcional) Top 10 clientes do pico — gráfico\n",
    "topn = by_client.head(10).copy()\n",
    "plt.figure(figsize=(8,4))\n",
    "plt.bar(topn['CLI_CPF'].astype(str), topn['fatur_cli'])\n",
    "plt.title(f\"Top 10 clientes no pico — {peak_day.date()} (SKU 1813)\")\n",
    "plt.ylabel(\"Faturamento (R$)\")\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ===== 4) Resumo do mês (cliente) =====\n",
    "by_client_month = (df_jan.groupby('CLI_CPF')\n",
    "                   .agg(fatur_mes=('FATUR_VENDA','sum'),\n",
    "                        dias_compra=('DATA_ATEND', lambda s: s.dt.date.nunique()))\n",
    "                   .reset_index()\n",
    "                  )\n",
    "clientes_unicos = by_client_month.shape[0]\n",
    "ticket_medio_cli = by_client_month['fatur_mes'].mean() if clientes_unicos>0 else 0.0\n",
    "perc_recorrentes = (by_client_month['dias_compra'].ge(2).mean()*100) if clientes_unicos>0 else 0.0\n",
    "\n",
    "print(\"\\n[Resumo de JAN/2024 — por cliente]\")\n",
    "print(f\"- Clientes únicos no mês: {clientes_unicos}\")\n",
    "print(f\"- Tíquete médio por cliente (no mês): R$ {ticket_medio_cli:,.2f}\")\n",
    "print(f\"- % clientes recorrentes (≥2 dias no mês): {perc_recorrentes:,.2f}%\")\n"
   ]
