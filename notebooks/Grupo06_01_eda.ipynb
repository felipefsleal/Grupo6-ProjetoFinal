   "source": [
    "# === Análise de concentração diária por cliente (SKU 1813) ===\n",
    "# Objetivo: detectar dias em que um único cliente concentrou >=90% do volume (quantidade) vendido do SKU 1813.\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# 0) Carrega vendas se ainda não existir\n",
    "try:\n",
    "    vendas\n",
    "except NameError:\n",
    "    vendas = pd.read_csv('vendas.csv', encoding='utf-8')\n",
    "\n",
    "# 1) Padroniza colunas principais\n",
    "dfv = vendas.copy()\n",
    "# Datas\n",
    "if 'DATA_ATEND' not in dfv.columns:\n",
    "    raise ValueError(\"Coluna 'DATA_ATEND' não encontrada em vendas.csv\")\n",
    "dfv['DATA_ATEND'] = pd.to_datetime(dfv['DATA_ATEND'])\n",
    "\n",
    "# SKU -> numérico\n",
    "if 'SKU' not in dfv.columns:\n",
    "    raise ValueError(\"Coluna 'SKU' não encontrada em vendas.csv\")\n",
    "dfv['SKU'] = pd.to_numeric(dfv['SKU'], errors='coerce')\n",
    "\n",
    "# Cliente\n",
    "if 'CLI_CPF' not in dfv.columns:\n",
    "    raise ValueError(\"Coluna 'CLI_CPF' não encontrada em vendas.csv\")\n",
    "dfv['CLI_CPF'] = dfv['CLI_CPF'].astype(str).str.strip().replace({'nan': np.nan})\n",
    "\n",
    "# Faturamento\n",
    "if 'FATUR_VENDA' not in dfv.columns:\n",
    "    raise ValueError(\"Coluna 'FATUR_VENDA' não encontrada em vendas.csv\")\n",
    "dfv['FATUR_VENDA'] = pd.to_numeric(dfv['FATUR_VENDA'], errors='coerce').fillna(0.0)\n",
    "\n",
    "# Quantidade (tenta possíveis nomes)\n",
    "qty_candidates = ['QTDE', 'QUANTIDADE', 'QTD', 'QTD_VENDA']\n",
    "qty_col = next((c for c in qty_candidates if c in dfv.columns), None)\n",
    "if qty_col is None:\n",
    "    raise ValueError(f\"Coluna de quantidade não encontrada. Tente ajustar um dos nomes: {qty_candidates}\")\n",
    "dfv[qty_col] = pd.to_numeric(dfv[qty_col], errors='coerce').fillna(0.0)\n",
    "\n",
    "# 2) Filtra SKU 1813 e mês/ano desejado (se quiser todo o ano, comente as linhas de between)\n",
    "sku_alvo = 1813\n",
    "dff = dfv[dfv['SKU'] == sku_alvo].copy()\n",
    "# Ex.: janeiro/2024 (comente se quiser geral)\n",
    "# dff = dff[(dff['DATA_ATEND'] >= '2024-01-01') & (dff['DATA_ATEND'] <= '2024-01-31')]\n",
    "\n",
    "if dff.empty:\n",
    "    raise ValueError(\"Sem dados do SKU 1813 no período filtrado.\")\n",
    "\n",
    "# 3) Agrega por dia x cliente\n",
    "grp = (dff.groupby(['DATA_ATEND', 'CLI_CPF'], dropna=False)\n",
    "          .agg(qtd=(qty_col, 'sum'),\n",
    "               fatur=('FATUR_VENDA', 'sum'))\n",
    "          .reset_index())\n",
    "\n",
    "# 4) Calcula participação do cliente no dia (por quantidade)\n",
    "daily_tot = grp.groupby('DATA_ATEND', as_index=False)['qtd'].sum().rename(columns={'qtd': 'qtd_total_dia'})\n",
    "g = grp.merge(daily_tot, on='DATA_ATEND', how='left')\n",
    "g['share_qtd'] = np.where(g['qtd_total_dia'] > 0, g['qtd'] / g['qtd_total_dia'], 0.0)\n",
    "\n",
    "# 5) Encontra dias com concentração (>= 90% do volume por um único cliente)\n",
    "threshold = 0.90\n",
    "concentrados = g[g['share_qtd'] >= threshold].copy()\n",
    "\n",
    "# 6) Resumos\n",
    "total_dias = g['DATA_ATEND'].nunique()\n",
    "dias_conc = concentrados['DATA_ATEND'].nunique()\n",
    "pct_dias_conc = 100 * dias_conc / total_dias if total_dias else 0\n",
    "\n",
    "# Clientes envolvidos nesses dias e seus volumes nesses dias\n",
    "clientes_conc = (concentrados.groupby('CLI_CPF', dropna=False)\n",
    "                 .agg(qtd_total_conc=('qtd', 'sum'),\n",
    "                      dias_envolvido=('DATA_ATEND', 'nunique'))\n",
    "                 .sort_values(['qtd_total_conc', 'dias_envolvido'], ascending=False)\n",
    "                 .reset_index())\n",
    "\n",
    "# Tabela de dias concentrados (quem foi o cliente e quanto representou)\n",
    "dias_conc_tab = (concentrados[['DATA_ATEND','CLI_CPF','qtd','qtd_total_dia','share_qtd']]\n",
    "                 .sort_values(['DATA_ATEND','share_qtd'], ascending=[True, False]))\n",
    "dias_conc_tab['share_qtd_%'] = (dias_conc_tab['share_qtd'] * 100).round(2)\n",
    "\n",
    "# 7) Impressões\n",
    "print(f\"[Janela analisada] Dias com venda do SKU {sku_alvo}: {total_dias}\")\n",
    "print(f\"[Concentração] Dias com cliente >= {int(threshold*100)}% do volume: {dias_conc} ({pct_dias_conc:.1f}% dos dias)\\n\")\n",
    "\n",
    "print(\"[Dias concentrados — cliente dominante por dia]\")\n",
    "if dias_conc_tab.empty:\n",
    "    print(\"Nenhum dia com concentração >= 90% por um único cliente.\")\n",
    "else:\n",
    "    print(dias_conc_tab[['DATA_ATEND','CLI_CPF','qtd','qtd_total_dia','share_qtd_%']].to_string(index=False))\n",
    "\n",
    "print(\"\\n[Clientes que apareceram em dias concentrados — ordenado por volume nesses dias]\")\n",
    "if clientes_conc.empty:\n",
    "    print(\"Nenhum cliente em dias concentrados.\")\n",
    "else:\n",
    "    print(clientes_conc.to_string(index=False))\n",
    "\n",
    "# 8) (Opcional) Top 10 clientes por quantidade em dias concentrados\n",
    "try:\n",
    "    import matplotlib.pyplot as plt\n",
    "    top10 = clientes_conc.head(10)\n",
    "    if not top10.empty:\n",
    "        plt.figure(figsize=(8,3.5))\n",
    "        plt.bar(top10['CLI_CPF'].astype(str), top10['qtd_total_conc'])\n",
    "        plt.title(f\"Top 10 clientes (dias concentrados) — SKU {sku_alvo}\")\n",
    "        plt.ylabel(\"Quantidade total (dias concentrados)\")\n",
    "        plt.xticks(rotation=45, ha='right')\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "except Exception as e:\n",
    "    print(f\"[Aviso] Gráfico não exibido: {e}\")\n"
   ]
  }
