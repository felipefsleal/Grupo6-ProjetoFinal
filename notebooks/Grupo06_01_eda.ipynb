   "source": [
    "import calendar\n",
    "from datetime import date\n",
    "\n",
    "# 1. Configurar o ano de análise\n",
    "ANO = 2024\n",
    "\n",
    "# 2. Mapeamento de nomes de dias (de 0=Segunda a 6=Domingo)\n",
    "dias_pt = {\n",
    "    0: 'Segunda-feira', 1: 'Terça-feira', 2: 'Quarta-feira',\n",
    "    3: 'Quinta-feira', 4: 'Sexta-feira', 5: 'Sábado', 6: 'Domingo'\n",
    "}\n",
    "\n",
    "# 3. Inicializar a estrutura de dados (Tabela de Contagem)\n",
    "# As chaves são os dias do mês (1 a 31). Os valores serão dicionários de contagem de dias.\n",
    "contagem_dias = {dia_mes: {nome_dia: 0 for nome_dia in dias_pt.values()} for dia_mes in range(1, 32)}\n",
    "\n",
    "# 4. Iterar sobre todos os meses do ano de 2024\n",
    "for mes in range(1, 13):\n",
    "    # calendar.Calendar(0) começa a semana na Segunda-feira (0)\n",
    "    cal = calendar.Calendar(0)\n",
    "    \n",
    "    # Gera uma lista de tuplas (dia_do_mes, dia_da_semana_indice)\n",
    "    mes_info = cal.itermonthdays2(ANO, mes)\n",
    "    \n",
    "    for dia_mes, dia_semana_indice in mes_info:\n",
    "        # 0 significa que o dia_mes não existe naquele mês (é preenchimento do calendário), ignorar\n",
    "        if dia_mes == 0:\n",
    "            continue\n",
    "        \n",
    "        # O dia 29, 30 e 31 não existem em todos os meses\n",
    "        if dia_mes in contagem_dias:\n",
    "            nome_dia_semana = dias_pt[dia_semana_indice]\n",
    "            contagem_dias[dia_mes][nome_dia_semana] += 1\n",
    "\n",
    "# 5. Converter o resultado para um DataFrame Pandas\n",
    "# Transforma o dicionário aninhado em um DataFrame\n",
    "df_calendario = pd.DataFrame(contagem_dias).T \n",
    "\n",
    "# 6. Limpar e formatar o DataFrame\n",
    "# Adicionar o Dia do Mês como coluna\n",
    "df_calendario.index.name = 'Dia_do_Mês'\n",
    "df_calendario.reset_index(inplace=True)\n",
    "\n",
    "# Preencher NaN (dias 29, 30, 31 em meses curtos) com 0 e converter para inteiro\n",
    "df_calendario = df_calendario.fillna(0).astype(int)\n",
    "\n",
    "# 7. Exibir o resultado\n",
    "print(f\"--- Frequência de Dias da Semana por Dia do Mês (Ano {ANO}) ---\")\n",
    "df_calendario"
   ]
  },
